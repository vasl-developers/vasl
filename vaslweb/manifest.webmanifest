{
  "name": "ASLwebtest",
  "short_name": "ASLwebtest",
  "description": "Carte VASL dans le navigateur : ouvrir, jouer et relire des parties .vsav / .vlog.",
  "lang": "fr",
  "id": "./",
  "start_url": "./VASLweb.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#2b2b2b",
  "theme_color": "#2b2b2b",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./VASLweb.html",
      "accept": { "application/octet-stream": [".vsav", ".vlog"] },
      "launch_type": "single-client"
    }
  ]
}
